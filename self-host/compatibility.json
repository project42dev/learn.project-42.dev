{
  "schemaVersion": 1,
  "application": {
    "name": "project42-learn",
    "version": "0.12.1"
  },
  "platform": {
    "requiredVersion": "0.88.0"
  },
  "runtime": {
    "containerPort": 8080,
    "healthPath": "/health",
    "configurationMode": "build-time"
  },
  "identity": {
    "protocol": "API-owned OIDC Authorization Code with PKCE",
    "sessionTransport": "secure-http-only-cookie",
    "browserTokenStorage": "forbidden",
    "publicConfiguration": [
      "NEXT_PUBLIC_PROJECT42_API_ORIGIN"
    ],
    "requiredClaims": []
  }
}
